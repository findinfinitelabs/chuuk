# Important: Include frontend source files
!frontend/
!frontend/**

.git
.gitignore
__pycache__
*.pyc
.env
venv
.vscode

# Only exclude node_modules in specific locations
**/node_modules

# Logs and outputs
logs
output
uploads
*.log
.DS_Store

# Large data assets (not needed for runtime image)
data
test_results
training_data

# Documentation
README.md
docs
backup
tests
*.md

# Scripts not needed in container
deploy-azure.sh
run.sh
dev-start.sh
dev-start.ps1

# Exclude large training checkpoint files (but keep finetuned models)
models/**/checkpoint-*
training_data
data/brochures
# Fine-tuned Helsinki weights are served from the Azure File Share mounted at
# MODEL_STORE_PATH (see ensure_model_storage in deploy-chuuk.sh), so they must not
# be baked into the image — they add ~4GB of build context and go stale immediately.
models/*/finetuned
models/*/checkpoint-*
models/*/lora_adapters
