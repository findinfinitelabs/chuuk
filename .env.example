# Chuuk Dictionary OCR Environment Configuration

# Database Configuration
# Set to 'mongodb' for local MongoDB or 'cosmos' for Azure Cosmos DB Emulator
DB_TYPE=mongodb

# MongoDB Configuration (when DB_TYPE=mongodb)
MONGODB_URI=mongodb://localhost:27017/

# Cosmos DB Configuration (when DB_TYPE=cosmos)
# Local emulator settings (default)
COSMOS_DB_URI=https://localhost:8081
COSMOS_DB_KEY-

# For Azure deployment, use these instead:
# COSMOS_DB_URI=https://your-account.documents.azure.com:443/
# COSMOS_DB_KEY=your-primary-or-secondary-key

# Google Cloud Vision API credentials path
# Download your service account JSON key from Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Flask configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Feature flags
# Set to true to enable Ollama LLM (disabled by default - uses resources unnecessarily)
OLLAMA_ENABLED=false

# Continuous training scheduler
# Interval in minutes between scheduled training runs
TRAINING_INTERVAL_MINUTES=30
# Minimum new training pairs required before a scheduled run triggers
TRAINING_MIN_NEW_PAIRS=10
# Number of LoRA updates before merging into base model
LORA_MERGE_THRESHOLD=50

# Upload configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
