# Chuuk Dictionary — Environment Configuration
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Prefer managed identity or Key Vault over pasting long-lived keys here.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection is resolved in this order by src/database/db_factory.py:
#   1. COSMOS_MONGO_CONNECTION_STRING / COSMOS_CONNECTION_STRING
#   2. COSMOS_ACCOUNT_NAME + USE_MANAGED_IDENTITY=true
#   3. COSMOS_DB_URI + COSMOS_DB_KEY
#   4. MONGODB_URI
#
# 'mongodb' for local MongoDB, 'cosmos' for Cosmos DB (emulator or Azure).
DB_TYPE=mongodb

# --- Option A: local MongoDB (simplest for development) --------------------
MONGODB_URI=mongodb://localhost:27017/

# --- Option B: managed identity (preferred in Azure — no secret to leak) ----
# COSMOS_ACCOUNT_NAME=your-cosmos-account
# USE_MANAGED_IDENTITY=true

# --- Option C: connection string -------------------------------------------
# COSMOS_MONGO_CONNECTION_STRING=mongodb://...
# COSMOS_CONNECTION_STRING=mongodb://...

# --- Option D: endpoint + key (long-lived credential; rotate if exposed) ----
# COSMOS_DB_URI=https://your-account.documents.azure.com:443/
# COSMOS_DB_KEY=your-primary-or-secondary-key

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
# REQUIRED in production — the app refuses to start without it when
# FLASK_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_ENV=development
PORT=5002

# ---------------------------------------------------------------------------
# Users
# ---------------------------------------------------------------------------
# Users come from Cosmos DB, then APP_USERS_JSON, then config/users.json.
# Create a local user with:
#   python scripts/manage_users.py add you@example.com --name "You" --role admin
# APP_USERS_JSON={"users":[{"email":"you@example.com","access_code":"...","name":"You","role":"admin"}]}

# ---------------------------------------------------------------------------
# OCR (optional — Tesseract alone works; Vision improves difficult scans)
# ---------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
# GOOGLE_CLOUD_API_KEY=
# GOOGLE_VISION_API_KEY=

# ---------------------------------------------------------------------------
# Translation and training
# ---------------------------------------------------------------------------
# Ollama LLM backend — disabled by default, it is resource-heavy.
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434

# Writable path for fine-tuned weights, preferred over the baked-in models/.
# MODEL_STORE_PATH=/app/model_store
# Skip CUDA/MPS detection and train on CPU.
# FORCE_CPU=false

# Continuous training scheduler
TRAINING_INTERVAL_MINUTES=30
TRAINING_MIN_NEW_PAIRS=10
LORA_MERGE_THRESHOLD=50

# ---------------------------------------------------------------------------
# Magic-link email (optional — access-code login works without it)
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
