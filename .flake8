[flake8]
max-line-length = 120
extend-ignore = E203, W503, W504, E226
# E203: whitespace before ':' (conflicts with black)
# W503: line break before binary operator (conflicts with black)
# W504: line break after binary operator (conflicts with black)
# E226: missing whitespace around arithmetic operator (style preference)
per-file-ignores =
    # E402: module imports not at top - needed for sys.path manipulation
    scripts/*:E402
    src/utils/retrain_all_models.py:E402
    # F601: repeated dict keys - valid in MongoDB query syntax ($ne, $or, etc.)
    src/database/dictionary_db.py:F601
    app.py:F601,E402
